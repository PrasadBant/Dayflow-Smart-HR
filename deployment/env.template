# Dayflow HRMS — Environment Variables Template

# ==========================================
# Backend Configuration (dayflow-hrms/backend)
# ==========================================

# Express HTTP Server Port
PORT=5000

# PostgreSQL Database Connection String
# Format: postgres://username:password@hostname:port/database_name
# Must be the non-superuser `dayflow_app` role (created by
# database/a7_rls.sql), NOT the database's own POSTGRES_USER superuser —
# see README.md's "Authentication & authorization" section for why
# row-level security depends on this.
DATABASE_URL=postgres://dayflow_app:dayflow_app_password@localhost:5432/dayflow_db

# JWT Secret Key for Session Authentication (Must be 32+ characters).
# Generate your own — never reuse this placeholder or any value that has
# ever appeared in a committed file: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-value-you-generate-yourself

# Node Environment (development | production | test)
NODE_ENV=development

# Allowed Origin for Frontend CORS
FRONTEND_ORIGIN=http://localhost:3000

# Optional — leave all unset to fall back to logging verification/password-
# reset links to the backend console instead of emailing them. Set all five
# to send real email via nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com

# ==========================================
# Frontend Configuration (dayflow-hrms/frontend)
# ==========================================

# Public API URL accessible by client browser
VITE_API_URL=http://localhost:5000/api

# Root-level overrides for docker-compose.yml (docker compose auto-loads a
# ".env" file from this directory). Copy to ".env" and set real values for
# anything beyond a disposable local run — never commit the real file.
POSTGRES_USER=dayflow_user
POSTGRES_PASSWORD=dayflow_password
POSTGRES_DB=dayflow_db
JWT_SECRET=replace-with-a-long-random-value-you-generate-yourself

# The backend connects to Postgres as this role, not POSTGRES_USER above —
# see docker-compose.yml's comment on DATABASE_URL for why (RLS enforcement).
# Must match the role/password database/a7_rls.sql creates inside the DB.
APP_DB_USER=dayflow_app
APP_DB_PASSWORD=dayflow_app_password
